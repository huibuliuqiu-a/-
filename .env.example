# Example environment variables
# Copy to .env and fill with your API keys

# Football data / odds API (example: API-FOOTBALL or football-data.org)
FOOTBALL_API_PROVIDER=api-football
FOOTBALL_API_KEY=

# Optional geocoding provider (Nominatim/OpenStreetMap)
GEOCODER_PROVIDER=nominatim

# Database
DATABASE_URL=sqlite:///data/predictions.db

# App settings
HOST=0.0.0.0
PORT=8000
